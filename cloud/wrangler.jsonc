{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wikidex-cloud-poc",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "TIMER_PROBE",
        "class_name": "TimerProbe"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TimerProbe"]
    }
  ]
}
